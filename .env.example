# ==============================================================================
# ⚙️ CONFIGURAÇÕES DA API SKULD (FastAPI)
# ==============================================================================
# Porta exposta no host para o container Docker
API_HOST_PORT=8000

# Diretório interno no container onde os arquivos pesados serão salvos (mapeado nos Volumes)
CACHE_DIR=/app/temp/cache_maquina_tempo
MODELS_DIR=/app/app/ml/models

# === Conexão com a réplica do Replicado (obrigatório) ======================
# Em geral aponta para 127.0.0.1:1433 via TÚNEL SSH até o host do Replicado
# (ver AGENTS.md). Se a conexão der "timed out", reinicie o túnel — não é
# bug do código.
REPLICADO_HOST=127.0.0.1
REPLICADO_PORT=1433
REPLICADO_DATABASE=replicado
REPLICADO_USERNAME=seu_usuario_somente_leitura
REPLICADO_PASSWORD=troque_essa_senha_ficticia
# 1 = dialeto Sybase (charset/TDS da USP). 0 = MSSQL puro.
REPLICADO_SYBASE=1

# === Escopo da unidade (OBRIGATÓRIO p/ pipeline de alocação) ===============
# O pacote é agnóstico à unidade: NENHUM colegiado ou prefixo é hardcodeado.
# Defina aqui o escopo da SUA unidade; exemplo abaixo = IME-USP.

# REPLICADO_CODUNDCLG: código do colegiado/unidade (inteiro). Filtra
# CURSOGR, GRADECURRICULAR, CALENDGR, HABILITACAOGR etc.
#   Exemplos:
#     45  -> IME-USP
#     8   -> FFLCH
#     16  -> Escola Politécnica
REPLICADO_CODUNDCLG=45

# REPLICADO_PREFIXOS_DISC: lista CSV de prefixos de disciplina da unidade,
# aplicada via coddis.startswith(prefixo). Disciplinas de outras unidades
# que apareçam no cache local (ex.: 43xxxxx = Física IFUSP ministrada no
# IME) ficam DE FORA se não listadas aqui.
#   Exemplos:
#     IME-USP : 45,MAC,MAE,MAT,MAP,MPM   (o "45" cobre 4500xxx antigas)
#     FFLCH   : 50,FLF,FLM,FLT,FLG,FLA,FLP (ilustrativo; confira com a unidade)
REPLICADO_PREFIXOS_DISC=45,MAC,MAE,MAT,MAP,MPM

# === Saneamento do dataset (opcionais — defaults abaixo são genéricos) =====
# Calibrados na engenharia reversa do IME, mas servem de partida para
# qualquer unidade. Ajuste conforme sua realidade.

# Sufixo mínimo do codtur (formato AAAASTT). 40 = turmas "reais" de
# oferecimento; sufixos menores costumam ser inserções manuais.
REPLICADO_SUFIXO_MIN=40

# Janela de anos do dataset. O HISTESCOLARGR local confiável costuma começar
# em 2010; ANO_MAX default = ano CORRENTE (computado em runtime), então não
# precisa ser editado todo ano — basta extrair o novo cache via
# scripts/extrair_cache_replicado.py. Anos sem cache são ignorados
# graciosamente (aviso), não crasham.
REPLICADO_ANO_MIN=2010
# REPLICADO_ANO_MAX (opcional) — se omitido, usa o ano corrente. Defina
# explicitamente apenas para fixar uma janela passada.
# REPLICADO_ANO_MAX=2026

# Offset (dias) do "Dia D": estmtr = registros criados até
# dtainitur - REPLICADO_DIAS_CORTE. (Validado: MAE 2.66, corr 0.980 no IME.)
REPLICADO_DIAS_CORTE=5

# Piso de vagas: vagas_reais = max(soma DETTURMAGR, PISO_VAGAS). Evita salas
# "fantasma" com 0 vagas cadastradas.
REPLICADO_PISO_VAGAS=30

# Top-K cursos ativos (hoje) que recebem colunas de vagas/rep/fluxo.
# Cursos inativos hoje não recebem colunas mesmo com vagas antigas.
REPLICADO_TOP_CURSOS=12